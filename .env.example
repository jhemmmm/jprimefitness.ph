APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jprimefitness.ph
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

KIOSK_TOKEN=
KIOSK_PAYMENT_TIMEOUT_SECONDS=120

BIOMETRIC_TOKEN=
BIOMETRIC_HELPER_ENABLED=true
BIOMETRIC_HELPER_BASE_URL=
BIOMETRIC_HELPER_TIMEOUT=60
BIOMETRIC_ENROLLMENT_TIMEOUT=30
BIOMETRIC_FINGERPRINT_ID=1

TRUSTED_PROXIES=127.0.0.1
CLOUDFLARE_TUNNEL_TOKEN=

PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
PAYMONGO_SUCCESS_URL=/register/success
PAYMONGO_CANCEL_URL=/register/cancelled
# Comma-separated list of PayMongo payment method types to offer at checkout.
# List only methods you've activated on your PayMongo dashboard — PayMongo
# silently filters out anything that isn't activated. Common values:
#   qrph, gcash, paymaya, card, grab_pay, billease
PAYMONGO_PAYMENT_METHODS=qrph

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Sync (live <-> local). Default 'standalone' = single-node, sync disabled.
# Set to 'live' on the public cloud server, 'local' on the on-premise PC.
APP_NODE_ROLE=standalone
NODE_ID=standalone
# Used only when APP_NODE_ROLE=local: where to push/pull and what token to send.
LIVE_API_URL=
LIVE_SYNC_TOKEN=
SYNC_HTTP_TIMEOUT=30
SYNC_PUSH_BATCH_SIZE=200
SYNC_PULL_BATCH_SIZE=500
# Used only when APP_NODE_ROLE=live: comma-separated client IPs allowed to hit /api/sync/*.
SYNC_ALLOWED_IPS=
